{
  "name": "portfolio",
  "type": "module",
  "packageManager": "yarn@4.16.0",
  "scripts": {
    "prepare": "husky",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro-check",
    "lint": "yarn lint:es && yarn lint:style",
    "lint:es": "eslint .",
    "lint:style": "stylelint \"src/**/*.{scss,astro}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{scss,astro}\" --fix",
    "lint:markup": "markuplint \"dist/**/*.html\"",
    "verify": "yarn build && yarn check && yarn lint && yarn lint:markup"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.10",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.2.8",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "microcms-js-sdk": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@emnapi/runtime": "^1.3.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "markuplint": "^4.18.3",
    "postcss": "^8.5.3",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro}": "eslint --fix",
    "*.{scss,astro}": "stylelint --fix"
  }
}
