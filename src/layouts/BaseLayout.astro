---
import '@/styles/global.scss';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import Stage from '@/components/Stage.astro';
import Analytics from '@vercel/analytics/astro';
import type { StageSceneName } from '@/scripts/stage/presets';

interface Props {
  title?: string;
  /** このページの背景の場面。セクション側の data-stage が優先される */
  stage?: StageSceneName;
}

const { title = 'My Portfolio', stage = 'default' } = Astro.props;
---

<html lang='ja'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='color-scheme' content='dark' />
    <meta name='theme-color' content='#020617' />
    <title>{title}</title>
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap'
      rel='stylesheet'
    />
    <ClientRouter />
  </head>
  <body>
    <Stage />
    <div class='l-Container'>
      <Header />
      <main class='l-Main' data-stage={stage}>
        <slot />
      </main>
    </div>
    <Analytics />
  </body>
</html>

<style lang='scss'>
  .l-Container {
    // 画面に固定した背景（.l-Stage）より手前に置く
    position: relative;
    z-index: 1;
    padding: 0 rem(24);

    @include min-screen(md) {
      padding: 0 rem(48);
    }

    @include min-screen(lg) {
      padding: 0 rem(96);
    }
  }
</style>
