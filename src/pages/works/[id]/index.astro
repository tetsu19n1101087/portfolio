---
export const prerender = false;

import { getWorkById } from '@/lib/works';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Carousel from '@/components/Carousel.astro';

const { id } = Astro.params;
const work = await getWorkById(id!);

if (!work) return Astro.redirect('/404');

const heroImage = work.image?.url ?? work.images[0]?.url;
---

<BaseLayout title={`${work.title} | My Portfolio`}>
  <article class='work'>
    <div class='work_header'>
      <!-- <p class='work_kicker'>works</p> -->
      <h1 class='work_title'>{work.title}</h1>
      <div class='work_meta'>
        <time class='work_date'>{work.date}</time>
        {
          work.tags.length > 0 && (
            <ul class='work_tags' aria-label='タグ'>
              {work.tags.map((tag) => (
                <li class='work_tag'>{tag.name}</li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
    <div class='work_body'>
      <div class='work_hero'>
        {
          work.images && work.images.length > 0 ? (
            <Carousel images={work.images} />
          ) : (
            heroImage && <img src={heroImage} alt={work.title} />
          )
        }
      </div>
      <p class='work_description'>{work.description}</p>
      <div class='work_text' set:html={work.text} />
      <div class='work_links'>
        {
          work.demoLink && (
            <a href={work.demoLink} target='_blank' rel='noopener noreferrer' class='work_link'>
              Demo →
            </a>
          )
        }
        {
          work.codeLink && (
            <a href={work.codeLink} target='_blank' rel='noopener noreferrer' class='work_link'>
              Code →
            </a>
          )
        }
      </div>
    </div>
    <div class='work-footer'>
      <a href='/works' class='work_back'>← All Works</a>
    </div>
  </article>
  <script>
    import '@/scripts/carousel';
  </script>
</BaseLayout>

<style lang='scss'>
  .work {
    display: flex;
    flex-direction: column;
    gap: rem(32);
    max-width: rem(768);
    padding: rem(48) 0;
    margin: 0 auto;

    @media (width <= 900px) {
      padding-top: rem(32);
    }
  }

  .work_header {
    display: grid;
    gap: rem(12);
    margin-bottom: rem(32);
  }

  .work_back {
    display: inline-flex;
    gap: rem(4);
    align-items: center;
    width: fit-content;
    font-size: rem(13.6);
    color: #6b7280;
    transition: color 160ms ease;

    @include hover {
      color: var(--color-accent);
    }
  }

  .work_kicker {
    margin-top: rem(8);
    font-size: rem(12);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.24em;
  }

  .work_title {
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .work_meta {
    display: flex;
    flex-wrap: wrap;
    gap: rem(12);
    align-items: center;
    margin-top: rem(4);
  }

  .work_date {
    font-size: rem(13.6);
    color: #6b7280;
  }

  .work_tags {
    display: flex;
    flex-wrap: wrap;
    gap: rem(6.4);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .work_tag {
    padding: rem(3.2) rem(10.4);
    font-size: rem(12);
    font-weight: 600;
    color: var(--color-accent);
    background: rgb(14 165 164 / 8%);
    border-radius: 999px;
  }

  .work_hero img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .work_body {
    display: grid;
    gap: rem(24);
  }

  .work_description {
    padding-left: rem(16);
    font-size: rem(16.8);
    line-height: 1.8;
    color: #4b5563;
    border-left: 3px solid var(--color-accent);
  }

  .work_text {
    line-height: 1.8;
    color: var(--color-text);

    :global(h2),
    :global(h3) {
      margin-top: rem(32);
      margin-bottom: rem(12);
      letter-spacing: -0.02em;
    }

    :global(p) {
      margin-bottom: rem(16);
    }

    :global(img) {
      max-width: 100%;
      border-radius: var(--radius);
    }
  }

  .work_links {
    display: flex;
    flex-wrap: wrap;
    gap: rem(12);
  }

  .work_link {
    display: inline-flex;
    gap: rem(4);
    align-items: center;
    padding: rem(8.8) rem(17.6);
    font-size: rem(13.6);
    font-weight: 600;
    color: #fff;
    background: rgb(2 6 23 / 80%);
    border-radius: 999px;
    box-shadow: 0 4px 14px rgb(2 6 23 / 15%);
    transition:
      transform 160ms ease,
      background-color 160ms ease;

    @include hover {
      background: var(--color-accent);
      transform: translateY(rem(-2));
    }
  }

  :global(.carousel) {
    display: flex;
    align-items: center;
  }

  :global(.carousel-view) {
    overflow: hidden;
    background: #f3f4f6;
    border-radius: calc(var(--radius) * 2);
    box-shadow: 0 4px 20px rgb(2 6 23 / 8%);
  }

  :global(.carousel-track) {
    display: flex;
  }

  :global(.carousel-item) {
    flex: 0 0 100%;
    min-width: 0;
  }

  :global(.carousel-item img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
