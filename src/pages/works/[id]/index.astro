---
export const prerender = false;

import { getWorkById } from '@/lib/works';
import BaseLayout from '@/layouts/BaseLayout.astro';
import './index.css';

const { id } = Astro.params;
const work = await getWorkById(id!);

if (!work) return Astro.redirect('/404');

const heroImage = work.image?.url ?? work.images[0]?.url;
---

<BaseLayout title={`${work.title} | My Portfolio`}>
  <article class='work'>
    <div class='work_header'>
      <p class='work_kicker'>works</p>
      <h1 class='work_title'>{work.title}</h1>
      <div class='work_meta'>
        <time class='work_date'>{work.date}</time>
        {
          work.tags.length > 0 && (
            <ul class='work_tags' aria-label='タグ'>
              {work.tags.map((tag) => (
                <li class='work_tag'>{tag.name}</li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
    <div class='work_body'>
      <div class='work_hero'>
        {heroImage && <img src={heroImage} alt={work.title} />}
      </div>
      <p class='work_description'>{work.description}</p>
      <div class='work_text' set:html={work.text} />
      <div class='work_links'>
        {
          work.demoLink && (
            <a href={work.demoLink} target='_blank' rel='noopener noreferrer' class='work_link'>
              Demo →
            </a>
          )
        }
        {
          work.codeLink && (
            <a href={work.codeLink} target='_blank' rel='noopener noreferrer' class='work_link'>
              Code →
            </a>
          )
        }
      </div>
    </div>
    <div class='work-footer'>
      <a href='/works' class='work_back'>← All Works</a>
    </div>
  </article>
</BaseLayout>
