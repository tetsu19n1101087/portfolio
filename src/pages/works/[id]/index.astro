---
export const prerender = false;

import { getWorkById } from '@/lib/works';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Carousel from '@/components/Carousel.astro';

const { id } = Astro.params;
const work = await getWorkById(id!);

if (!work) return Astro.redirect('/404');

const heroImage = work.image ?? work.images?.[0];
const displayDemoUrl = work.demoLink ? work.demoLink.replace(/^https?:\/\//, '').replace(/\/$/, '') : '';
---

<BaseLayout title={`${work.title} | Tetsuro Tsunehara`}>
  <article class="p-WorkDetail">
    <div class="p-WorkDetail__header">
      <h1 class="p-WorkDetail__title">{work.title}</h1>
      <div class="p-WorkDetail__meta">
        <time class="p-WorkDetail__date">{work.date}</time>
        {
          work.tags.length > 0 && (
            <ul class="p-WorkDetail__tags" aria-label="タグ">
              {work.tags.map((tag) => (
                <li class="p-WorkDetail__tag">{tag.name}</li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
    <div class="p-WorkDetail__body">
      <div class="p-WorkDetail__hero">
        {
          work.images && work.images.length > 0 ? (
            <Carousel images={work.images} />
          ) : (
            heroImage && <img src={heroImage.url} width={heroImage.width} height={heroImage.height} alt={work.title} />
          )
        }
      </div>
      {
        (work.demoLink || work.codeLink) && (
          <dl class="p-WorkDetail__links">
            {
              work.demoLink && (
                <div class="p-WorkDetail__linkItem">
                  <dt class="p-WorkDetail__linkLabel">Site:</dt>
                  <dd class="p-WorkDetail__linkValue">
                    <a href={work.demoLink} target="_blank" rel="noopener noreferrer" class="p-WorkDetail__link">
                      <span class="p-WorkDetail__linkText">{displayDemoUrl}</span>
                      <img src="/images/open_in_new.svg" alt="" width="16" height="16" class="p-WorkDetail__linkIcon" />
                      <span class="u-srOnly">（新しいタブで開きます）</span>
                    </a>
                  </dd>
                </div>
              )
            }
            {
              work.codeLink && (
                <div class="p-WorkDetail__linkItem">
                  <dt class="p-WorkDetail__linkLabel">Code:</dt>
                  <dd class="p-WorkDetail__linkValue">
                    <a href={work.codeLink} target="_blank" rel="noopener noreferrer" class="p-WorkDetail__link">
                      <span class="p-WorkDetail__linkText">GitHub</span>
                      <img src="/images/open_in_new.svg" alt="" width="16" height="16" class="p-WorkDetail__linkIcon" />
                      <span class="u-srOnly">（新しいタブで開きます）</span>
                    </a>
                  </dd>
                </div>
              )
            }
          </dl>
        )
      }
      <!-- <p class='p-WorkDetail__description'>{work.description}</p> -->
      <div class="p-WorkDetail__text" set:html={work.text} />
    </div>
    <div class="p-WorkDetail__footer">
      <a href="/works" class="p-WorkDetail__back">← All Works</a>
    </div>
  </article>
  <script>
    import '@/scripts/carousel';
  </script>
</BaseLayout>

<style lang="scss">
  .p-WorkDetail {
    display: flex;
    flex-direction: column;
    gap: rem(32);
    max-width: rem(768);
    padding: rem(48) 0;
    margin: 0 auto;

    @media (width <= 900px) {
      padding-top: rem(32);
    }
  }

  .p-WorkDetail__header {
    display: grid;
    gap: rem(12);
    margin-bottom: rem(32);
  }

  .p-WorkDetail__back {
    display: inline-flex;
    gap: rem(4);
    align-items: center;
    width: fit-content;
    font-size: rem(14);
    color: #6b7280;
    transition: color 160ms ease;

    @include hover {
      color: var(--color-accent);
    }
  }

  // .p-WorkDetail__kicker {
  //   margin-top: rem(8);
  //   font-family: var(--font-heading);
  //   font-size: rem(12);
  //   color: var(--color-accent);
  //   text-transform: capitalize;
  //   letter-spacing: 0.24em;
  // }

  .p-WorkDetail__title {
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .p-WorkDetail__meta {
    display: flex;
    flex-wrap: wrap;
    gap: rem(12);
    align-items: center;
    margin-top: rem(4);
  }

  .p-WorkDetail__date {
    font-size: rem(14);
    color: #6b7280;
  }

  .p-WorkDetail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: rem(6.4);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .p-WorkDetail__tag {
    padding: rem(3.2) rem(10.4);
    font-size: rem(12);
    font-weight: 600;
    color: var(--color-accent);
    background: rgb(14 165 164 / 8%);
    border-radius: 999px;
  }

  .p-WorkDetail__hero img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .p-WorkDetail__body {
    display: grid;
    gap: rem(24);
  }

  .p-WorkDetail__description {
    padding-left: rem(16);
    font-size: rem(16);
    line-height: 1.8;
    color: #4b5563;
    border-left: 3px solid var(--color-accent);
  }

  .p-WorkDetail__text {
    line-height: 1.8;
    color: var(--color-text);

    :global(h2),
    :global(h3),
    :global(h4) {
      margin-top: rem(32);
      margin-bottom: rem(12);
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    :global(h2) {
      padding-bottom: rem(8);
      font-size: rem(24);
      border-bottom: 1px solid #e5e7eb;
    }

    :global(p) {
      margin-bottom: rem(16);
    }

    :global(ul) {
      padding-left: rem(24);
      margin-bottom: rem(16);
      list-style-type: disc;
    }

    :global(ol) {
      padding-left: rem(24);
      margin-bottom: rem(16);
      list-style-type: decimal;
    }

    :global(li) {
      margin-bottom: rem(4);
    }

    :global(blockquote) {
      padding: rem(12) rem(16);
      margin: rem(16) 0;
      color: #6b7280;
      background: #f9fafb;
      border-left: 4px solid var(--color-accent);
      border-radius: 0 var(--radius) var(--radius) 0;

      :global(p:last-child) {
        margin-bottom: 0;
      }
    }

    :global(table) {
      width: 100%;
      margin: rem(24) 0;
      overflow-x: auto;
      border-collapse: collapse;
    }

    :global(th),
    :global(td) {
      padding: rem(8) rem(12);
      text-align: left;
      border: 1px solid #e5e7eb;
    }

    :global(th) {
      font-weight: 600;
      background: #f9fafb;
    }

    :global(pre) {
      padding: rem(16);
      margin: rem(20) 0;
      overflow-x: auto;
      font-size: rem(14);
      line-height: 1.6;
      border-radius: var(--radius);
    }

    :global(code:not(pre code)) {
      padding: rem(2) rem(6);
      font-size: rem(14);
      color: #eb5757;
      background: rgb(2 6 23 / 5%);
      border-radius: rem(4);
    }

    :global(hr) {
      margin: rem(32) 0;
      border: 0;
      border-top: 1px solid #e5e7eb;
    }

    :global(img) {
      max-width: 100%;
      height: auto;
      border-radius: var(--radius);
    }
  }

  .p-WorkDetail__links {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: rem(10) rem(8);
    padding: 0;
    margin: 0;
  }

  .p-WorkDetail__linkItem {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: center;
  }

  .p-WorkDetail__linkLabel {
    margin: 0;
    font-size: rem(15);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .p-WorkDetail__linkValue {
    min-width: 0;
    margin: 0;
  }

  .p-WorkDetail__link {
    display: inline-flex;
    gap: rem(4);
    align-items: center;
    font-size: rem(15);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    transition: color 160ms ease;

    @include hover {
      color: var(--color-accent-hover);

      .p-WorkDetail__linkIcon {
        opacity: 0.8;
      }
    }
  }

  .p-WorkDetail__linkText {
    word-break: break-all;
  }

  .p-WorkDetail__linkIcon {
    flex-shrink: 0;
    width: rem(16);
    height: rem(16);
    transition: opacity 160ms ease;
  }

  .p-WorkDetail__footer {
    padding-top: rem(16);
  }

  :global(.c-Carousel) {
    display: flex;
    align-items: center;
  }

  :global(.c-Carousel__view) {
    overflow: hidden;
    background: #f3f4f6;
    border-radius: calc(var(--radius) * 2);
    box-shadow: 0 4px 20px rgb(2 6 23 / 8%);
  }

  :global(.c-Carousel__track) {
    display: flex;
  }

  :global(.c-Carousel__item) {
    flex: 0 0 100%;
    min-width: 0;
  }

  :global(.c-Carousel__item img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
