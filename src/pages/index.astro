---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkCard from '@/components/WorkCard.astro';
import { getWorks } from '@/lib/works';

const works = await getWorks();
const featuredWorks = works.slice(0, 5);
---

<BaseLayout>
  <section class="p-HomeHero" aria-labelledby="site-title">
    <div class="p-HomeHero__copy">
      <h1 id="site-title" class="p-HomeHero__siteTitle">Tetsuro Tsunehara</h1>
      <p class="p-HomeHero__subtitle">Portfolio site</p>
    </div>
    <div class="p-HomeHero__cover" aria-hidden="true">
      <!-- <img src='/home-image.svg' alt='' /> -->
    </div>
    <div class="p-HomeHero__scrollHint" aria-hidden="true">
      <span class="p-HomeHero__scrollText">Scroll</span>
      <span class="p-HomeHero__scrollLine"></span>
    </div>
  </section>
  <section class="p-HomeWorks" aria-labelledby="works-title">
    <div class="p-HomeWorks__heading">
      <h2 id="works-title" class="p-HomeWorks__kicker">Works</h2>
    </div>
    {
      featuredWorks.length > 0 ? (
        <div class="p-HomeWorks__bentoGrid">
          {featuredWorks.map((work) => (
            <article>
              <WorkCard work={work} />
            </article>
          ))}
        </div>
      ) : (
        <p class="p-HomeWorks__emptyState">works はまだ登録されていません。</p>
      )
    }
    <a class="p-HomeWorks__viewAll" href="/works">
      View all
      <span aria-hidden="true">→</span>
    </a>
  </section>
  <section class="p-HomeAbout" aria-labelledby="about-title">
    <div class="p-HomeAbout__heading">
      <h2 id="about-title" class="p-HomeAbout__kicker">About</h2>
    </div>
    <dl class="p-HomeAbout__body">
      <div class="p-HomeAbout__item">
        <dt class="p-HomeAbout__label">Language</dt>
        <dd>
          <ul class="p-HomeAbout__list">
            <li>HTML</li>
            <li>CSS</li>
            <li>JavaScript</li>
            <li>TypeScript</li>
          </ul>
        </dd>
      </div>
      <div class="p-HomeAbout__item">
        <dt class="p-HomeAbout__label">Framework</dt>
        <dd>
          <ul class="p-HomeAbout__list">
            <li>Next.js</li>
            <li>Astro</li>
            <li>React</li>
            <li>Tailwind CSS</li>
          </ul>
        </dd>
      </div>
      <div class="p-HomeAbout__item">
        <dt class="p-HomeAbout__label">OS</dt>
        <dd>
          <ul class="p-HomeAbout__list">
            <li>macOS</li>
          </ul>
        </dd>
      </div>
      <div class="p-HomeAbout__item">
        <dt class="p-HomeAbout__label">Infrastructure</dt>
        <dd>
          <ul class="p-HomeAbout__list">
            <li>Vercel</li>
            <li>microCMS</li>
          </ul>
        </dd>
      </div>
      <div class="p-HomeAbout__item">
        <dt class="p-HomeAbout__label">Other</dt>
        <dd>
          <ul class="p-HomeAbout__list">
            <li>Git / GitHub</li>
            <li>Figma</li>
            <li>VSCode</li>
          </ul>
        </dd>
      </div>
    </dl>
  </section>
</BaseLayout>

<style lang="scss">
  .p-HomeHero {
    display: flex;
    flex-direction: column;
    gap: rem(32);
    align-items: center;
    height: calc(100vh - rem(72));
    padding: rem(64) 0;

    @media (width <= 900px) {
      padding-top: rem(32);
    }

    &__copy {
      display: flex;
      flex: auto;
      flex-direction: column;
      gap: rem(16);
      justify-content: center;
      width: 100%;
    }

    &__siteTitle {
      font-size: clamp(2.25rem, 15vw, 6rem);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    &__subtitle {
      max-width: rem(576);
      font-family: var(--font-heading);
      font-size: rem(16);
      line-height: 1.8;
      color: var(--color-accent);
      text-transform: uppercase;
      letter-spacing: 0.24em;
    }

    &__cover {
      overflow: hidden;
      background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
      border-radius: calc(var(--radius) * 2);
      box-shadow: 0 20px 50px rgb(2 6 23 / 8%);

      img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &__scrollHint {
      display: flex;
      flex-direction: column;
      gap: rem(8);
      align-items: center;
    }

    &__scrollText {
      font-family: var(--font-heading);
      font-size: rem(12);
      color: var(--color-accent);
      text-transform: uppercase;
      letter-spacing: 0.22em;
    }

    &__scrollLine {
      position: relative;
      width: rem(1);
      height: rem(40);
      overflow: hidden;
      background-color: var(--color-border);

      &::after {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        content: '';
        background-color: var(--color-accent);
        animation: scroll-line 1.6s ease-in-out infinite;

        @media (prefers-reduced-motion: reduce) {
          animation: none;
        }
      }
    }
  }

  @keyframes scroll-line {
    0% {
      transform: translateY(-100%);
    }

    100% {
      transform: translateY(100%);
    }
  }

  .p-HomeWorks {
    padding: rem(32) 0 rem(64);

    &__heading {
      display: grid;
      gap: rem(5.6);
      margin-bottom: rem(20);
    }

    &__kicker {
      font-size: clamp(2.5rem, 6vw, 5rem);
      line-height: 1.5;
      color: var(--color-accent);
      text-transform: capitalize;
      letter-spacing: rem(1.6);
    }

    &__bentoGrid {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--gap);

      @media (width <= 900px) {
        grid-template-columns: 1fr;
        grid-auto-rows: auto;

        > :nth-child(n) {
          grid-row: auto;
          grid-column: auto;
        }
      }

      > article {
        min-width: 0;
        min-height: 0;
      }

      > :nth-child(1) {
        grid-row: 1 / 3;
        grid-column: 1 / 5;
      }

      > :nth-child(2) {
        grid-row: 1 / 2;
        grid-column: 5 / 7;
      }

      > :nth-child(3) {
        grid-row: 2 / 3;
        grid-column: 5 / 7;
      }

      > :nth-child(4) {
        grid-row: 3 / 4;
        grid-column: 1 / 4;
      }

      > :nth-child(5) {
        grid-row: 3 / 4;
        grid-column: 4 / 7;
      }
    }

    &__emptyState {
      padding: rem(16) 0;
      color: #6b7280;
    }

    &__viewAll {
      display: flex;
      gap: rem(5.6);
      align-items: center;
      width: fit-content;
      padding: rem(8.8) rem(17.6);
      margin-top: var(--gap);
      margin-left: auto;
      font-size: rem(16);
      font-weight: 600;
      color: #fff;
      background: rgb(2 6 23 / 80%);
      border-radius: 999px;
      box-shadow: 0 4px 14px rgb(2 6 23 / 25%);
      transition:
        transform 160ms ease,
        background-color 160ms ease;

      span {
        transition: transform 160ms ease;
      }

      @include hover {
        background: var(--color-accent);
        transform: translateY(rem(-2));

        span {
          transform: translateX(rem(3));
        }
      }
    }
  }

  .p-HomeAbout {
    padding: rem(32) 0 rem(64);

    &__heading {
      display: grid;
      gap: rem(5.6);
      margin-bottom: rem(20);
    }

    &__kicker {
      font-size: clamp(2.5rem, 6vw, 5rem);
      line-height: 1.5;
      color: var(--color-accent);
      text-transform: capitalize;
      letter-spacing: rem(1.6);
    }

    &__body {
      display: grid;
      gap: rem(32);
    }

    &__item {
      display: grid;
      gap: rem(12);
    }

    &__label {
      font-size: rem(12);
      color: var(--color-accent);
      text-transform: uppercase;
      letter-spacing: 0.22em;
    }

    &__list {
      display: flex;
      flex-wrap: wrap;
      gap: rem(8) rem(24);
      padding: 0;
      margin: 0;
      list-style: none;

      li {
        font-size: rem(16);
        line-height: 1.4;
      }
    }
  }
</style>
