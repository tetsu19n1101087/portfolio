---
import type { Image } from '@/types/work';

interface Props {
  images: Image[];
}

const { images } = Astro.props;
---

<div class='c-Carousel js-carousel'>
  <!-- <button class='btn btn-prev' aria-label='Previous'> ‹ </button> -->
  <div class='c-Carousel__view js-carouselView'>
    <div class='c-Carousel__track'>
      {
        images.map((image, i) => (
          <div class='c-Carousel__item'>
            <img src={image.url} alt={`${i + 1}`} width={image.width ?? 800} height={image.height ?? 600} loading='lazy' />
          </div>
        ))
      }
    </div>
  </div>
  <!-- <button class='btn btn-next' aria-label='Next'> › </button> -->
</div>
