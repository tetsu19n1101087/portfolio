---
const { work } = Astro.props;

const id = work.id ?? work.contentId ?? work.slug ?? '';
const image = work.images?.[0] ?? work.thumbnail;
const imageUrl = image?.url ?? '';
const width = image?.width ?? 800;
const height = image?.height ?? 600;
const title = work.title ?? 'work title';
---

<a class='c-WorkCard' href={id ? `/works/${id}` : '#'}>
  <div class='c-WorkCard__media'>
    {
      imageUrl ? (
        <img src={imageUrl} alt={title} width={width} height={height} loading='lazy' />
      ) : (
        <div class='c-WorkCard__placeholder' />
      )
    }
  </div>
  <div class='c-WorkCard__overlay' aria-hidden='true'>
    <span class='c-WorkCard__title'>{title}</span>
  </div>
</a>

<style lang='scss'>
  .c-WorkCard {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #f3f4f6;
    border-radius: var(--radius);
    box-shadow: 0 1px 4px rgb(2 6 23 / 6%);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;

    @include hover {
      box-shadow: 0 8px 30px rgb(2 6 23 / 8%);

      .c-WorkCard__media::after {
        background: rgb(2 6 23 / 38%);
      }

      .c-WorkCard__title {
        opacity: 1;
        transform: translateY(0);
      }
    }

    &:focus-visible {
      .c-WorkCard__media::after {
        background: rgb(2 6 23 / 38%);
      }

      .c-WorkCard__title {
        opacity: 1;
        transform: translateY(0);
      }
    }

    &__media {
      position: relative;
      width: 100%;
      height: 100%;

      &::after {
        position: absolute;
        inset: 0;
        content: '';
        background: rgb(2 6 23 / 0%);
        transition: background-color 160ms ease;
      }
    }

    img,
    &__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &__placeholder {
      background: #f3f4f6;
    }

    &__overlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: flex-end;
      padding: rem(16);
      pointer-events: none;
    }

    &__title {
      font-size: rem(16);
      font-weight: 600;
      line-height: 1.2;
      color: #fff;
      text-shadow: 0 1px 2px rgb(2 6 23 / 45%);
      opacity: 0;
      transform: translateY(rem(8));
      transition:
        opacity 160ms ease,
        transform 160ms ease;
    }
  }
</style>
