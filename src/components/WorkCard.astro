---
const { work } = Astro.props;
import './WorkCard.css';

const id = work.id ?? work.contentId ?? work.slug ?? '';
const imageUrl = work.images[0]?.url ?? work.thumbnail?.url ?? '';
const title = work.title ?? 'work title';
---

<a class='work-card' href={id ? `/works/${id}` : '#'}>
  <div class='work-card_media'>
    {imageUrl ? <img src={imageUrl} alt={title} loading='lazy' /> : <div class='work-card_placeholder' />}
  </div>
  <div class='work-card_overlay' aria-hidden='true'>
    <span class='work-card_title'>{title}</span>
  </div>
</a>
