---
import type { Work } from '@/types/work';

interface Props {
  work: Work;
  /**
   * 画像の現れ方。
   * load: ページを開いたときに CSS だけで現れる（最初の画面に見えるカード用。画像の表示を遅らせない）
   * scroll: 画面に入ったときに、溶け出すように現れる
   */
  reveal?: 'load' | 'scroll';
  /** reveal="load" のとき、現れる順番（0 から） */
  order?: number;
}

const { work, reveal = 'scroll', order = 0 } = Astro.props;

const id = work.id ?? '';
const image = work.images?.[0] ?? work.image;
const imageUrl = image?.url ?? '';
const width = image?.width ?? 800;
const height = image?.height ?? 600;
const title = work.title ?? 'work title';
---

<!-- data-reveal は共通の出現アニメーション（CSS / GSAP）が拾う属性。scroll のカードは専用の演出で現すので付けない -->
<a
  class='c-WorkCard js-workCard'
  href={id ? `/works/${id}` : '#'}
  data-card-reveal={reveal}
  data-reveal={reveal === 'load' ? 'load' : undefined}
  style={`--reveal-order: ${order}`}
>
  <div class='c-WorkCard__media'>
    {
      imageUrl ? (
        <>
          {/* crossorigin: 溶け出す演出でこの画像を WebGL のテクスチャに使うために必要 */}
          <img
            class='c-WorkCard__image js-workCardImage'
            src={imageUrl}
            alt={title}
            width={width}
            height={height}
            loading={reveal === 'load' ? 'eager' : 'lazy'}
            crossorigin='anonymous'
          />
          <canvas class='c-WorkCard__canvas js-workCardCanvas' aria-hidden='true' />
        </>
      ) : (
        <div class='c-WorkCard__placeholder' />
      )
    }
  </div>
  <div class='c-WorkCard__overlay' aria-hidden='true'>
    <span class='c-WorkCard__title'>{title}</span>
  </div>
</a>

<script>
  import '@/scripts/workCard';
</script>

<style lang='scss'>
  .c-WorkCard {
    // ポインタの位置。中央が 0、端が ±1。src/scripts/workCard.ts が書き込む
    --tilt-x: 0;
    --tilt-y: 0;
    --tilt-active: 0;

    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--color-surface);
    border-radius: var(--radius);
    box-shadow: 0 1px 4px color-mix(in srgb, var(--color-dark) 40%, transparent);

    // ポインタの方向へ、立体的に少し傾ける
    transform: perspective(rem(900)) rotateX(calc(var(--tilt-y) * -5deg)) rotateY(calc(var(--tilt-x) * 5deg));
    transition:
      transform 260ms ease-out,
      box-shadow 160ms ease;

    @include hover {
      box-shadow: 0 8px 30px color-mix(in srgb, var(--color-dark) 60%, transparent);

      .c-WorkCard__media::after {
        background: color-mix(in srgb, var(--color-dark) 38%, transparent);
      }

      .c-WorkCard__title {
        opacity: 1;
        transform: translateY(0);
      }
    }

    &:focus-visible {
      .c-WorkCard__media::after {
        background: color-mix(in srgb, var(--color-dark) 38%, transparent);
      }

      .c-WorkCard__title {
        opacity: 1;
        transform: translateY(0);
      }
    }

    &__media {
      position: relative;
      width: 100%;
      height: 100%;

      &::after {
        position: absolute;
        inset: 0;
        content: '';
        background: color-mix(in srgb, var(--color-dark) 0%, transparent);
        transition: background-color 160ms ease;
      }
    }

    &__image,
    &__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &__image {
      clip-path: inset(0);

      // 傾けている間は、画像を少し拡大して逆方向へずらし、奥行きを出す
      scale: calc(1 + var(--tilt-active) * 0.05);
      translate: calc(var(--tilt-x) * -1.2%) calc(var(--tilt-y) * -1.2%);

      // is-revealPending が外れたときに、下から現れる（シェーダーが使えないときの出現）
      transition:
        opacity 700ms ease,
        clip-path 1000ms cubic-bezier(0.2, 0.7, 0.2, 1),
        scale 260ms ease-out,
        translate 260ms ease-out;
    }

    // 画面に入るまで画像を隠しておく
    &.is-revealPending &__image {
      opacity: 0;
      clip-path: inset(100% 0 0 0);
    }

    // 溶け出す演出を描く canvas。演出の間だけ画像の上に重ねる
    &__canvas {
      position: absolute;
      inset: 0;
      display: none;
      width: 100%;
      height: 100%;
    }

    &.is-revealCanvas &__canvas {
      display: block;
    }

    &__placeholder {
      background: var(--color-surface);
    }

    &__overlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: flex-end;
      padding: rem(16);
      pointer-events: none;
    }

    &__title {
      font-size: rem(16);
      font-weight: 600;
      line-height: 1.2;
      color: var(--color-text);
      text-shadow: 0 1px 2px color-mix(in srgb, var(--color-dark) 45%, transparent);
      opacity: 0;
      transform: translateY(rem(8));
      transition:
        opacity 160ms ease,
        transform 160ms ease;
    }
  }
</style>
