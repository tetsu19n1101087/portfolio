---
// 全ページ共通の背景。画面に固定した canvas に WebGL で描く。
// ページ遷移をまたいで同じ要素を使い続ける（描画の状態を保つため）。
---

<div class="l-Stage js-stage" aria-hidden="true" transition:persist="stage">
  <canvas class="l-Stage__canvas js-stageCanvas"></canvas>
</div>

<script>
  import { initStage } from '@/scripts/stage';

  const root = document.querySelector<HTMLElement>('.js-stage');
  if (root) {
    void initStage(root);
  }
</script>

<style lang="scss">
  .l-Stage {
    position: fixed;
    inset: 0 0 auto;
    z-index: 0;

    // モバイルでアドレスバーが出入りしても大きさが変わらない高さにする（描画の作り直しを避ける）
    height: 100lvh;
    contain: strict;
    pointer-events: none;

    // WebGL が使えない・まだ読み込めていないときに見える静的な背景
    background: radial-gradient(
      120% 90% at 78% 30%,
      color-mix(in srgb, var(--color-accent) 20%, var(--color-bg)) 0%,
      var(--color-bg) 62%
    );

    &__canvas {
      display: block;
      width: 100%;
      height: 100%;
      opacity: 0;
      transition: opacity 1200ms ease;
    }

    &.is-ready &__canvas {
      opacity: 1;
    }
  }
</style>
